; 复制为 config.ini 再填你自己的值：cp config.ini.example config.ini
; config.ini 里有真实 key，已在 .gitignore，不要提交。

[server]
debug = True
secret_key = django-insecure-code-harmness-dev-only
allowed_hosts = localhost,127.0.0.1

[cors]
allowed_origins = http://localhost:5173,http://127.0.0.1:5173

[deepseek]
; 必填：https://platform.deepseek.com
api_key = sk-your-key-here
; 可选：默认 deepseek-v4-flash，可换 deepseek-v4-pro
model = deepseek-v4-flash
; 可选：一般不用改
base_url = https://api.deepseek.com

[storage]
; 存放会话文件的根目录；每个会话的文件在 <dir>/input/<会话id>/file/。相对路径按 backend/ 解析
dir = storage
; 单个上传文件的大小上限，单位 MB
max_upload_mb = 20
